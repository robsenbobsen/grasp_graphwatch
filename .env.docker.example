# Env file for docker-compose.yml. Copy and adjust:
#   cp .env.docker.example .env.docker
# docker compose also reads this file for ${...} substitution when passed via
# `--env-file .env.docker`; otherwise the defaults in docker-compose.yml apply.

# --- doc-comp_postgres ---
POSTGRES_USER=grasp
POSTGRES_PASSWORD=grasp
POSTGRES_PORT=8888
POSTGRES_DB_NAME=sysdig

# --- Detection service DB connection, read by grasp/config.py and the sysdig pipeline ---
# Bundled doc-comp_postgres: in-network host/port (NOT the host-mapped POSTGRES_PORT).
db_user=grasp
db_password=grasp
db_host=doc-comp_postgres
db_port=5432
db_name=sysdig

# Existing Postgres on the host instead (e.g. PIDSMaker's): replace the block above with
# db_host=host.docker.internal
# db_port=8888

# Optional: experiment config run by doc-comp_grasp.
# GRASP_EXPERIMENT_CONFIG=grasp/experiments/all_experiments/cadets_e3_default/experiment_cadets_e3.yaml
