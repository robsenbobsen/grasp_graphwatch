# Env file for docker-compose.yml. Copy and adjust:
#   cp .env.docker.example .env.docker
# The containers read it as environment (env_file). Variables of docker-compose.yml
# itself (POSTGRES_PORT, API_PORT, HOST_UID, ...) go into .env instead.

# --- doc-comp_postgres (only with `docker compose --profile db up -d`) ---
# User, password and default DB are applied when its volume is first initialized.
# The host port is set in .env (POSTGRES_PORT, used by docker-compose.yml itself).
POSTGRES_USER=grasp
POSTGRES_PASSWORD=grasp
POSTGRES_DB=sysdig
# Databases that should exist; missing ones are created on every `--profile db up`
# (comma-separated, letters/digits/_ only). Existing ones are not touched.
POSTGRES_DATABASES=sysdig_coffeebot_static,sysdig_coffeebot_live

# --- Detection service DB connection, read by grasp/config.py and the sysdig pipeline ---
# Set exactly ONE value per key (with duplicates the last line wins). The database itself
# (db_name) is chosen per API request.
#
# Default setup: an existing Postgres server that holds the data. db_host is its address
# (an IP/hostname, or host.docker.internal for a Postgres on this machine).
db_user=postgres
db_password=change-me
db_host=change-me
db_port=8899
#
# Bundled doc-comp_postgres instead (docker compose --profile db up -d):
#   db_user=grasp, db_password=grasp, db_host=doc-comp_postgres, db_port=5432

# Optional: experiment config run by doc-comp_grasp.
# GRASP_EXPERIMENT_CONFIG=grasp/experiments/all_experiments/cadets_e3_default/experiment_cadets_e3.yaml

# --- doc-comp_detection_api ---
# Clients send it as the X-API-Key header. Generate one with: openssl rand -hex 32
GRASP_API_KEY=change-me
